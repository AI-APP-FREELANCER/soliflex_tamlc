# Copy this file to "backend/.env" on the server and fill in real values.
# Never commit the real ".env" — it's already in .gitignore.
# This is a plain (non-Docker) deployment: Node run directly via PM2, Nginx as reverse proxy.

# --- Domain (same-origin: Nginx serves the frontend and proxies /api, /uploads,
# /socket.io to this backend under the same domain, so CORS never comes into play) ---
CORS_ORIGIN=https://tms.soliflexpackaging.com

# --- DigitalOcean Managed Database connection string ---
# Get this from: Databases -> soliflex-db -> Connection Details -> "Connection string"
# Use the PRIVATE network hostname if this server lives in the same DigitalOcean
# VPC/region as the database (faster, never touches the public internet); otherwise
# use the PUBLIC hostname. Either way it must include sslmode=require.
DATABASE_URL=postgresql://doadmin:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:25060/soliflex_ticketing?sslmode=require

# --- Backend secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Server ---
PORT=4000
NODE_ENV=production
UPLOAD_DIR=/var/www/soliflex/uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# --- Frontend ---
# No VITE_API_BASE_URL needed for a normal same-origin deploy — the frontend
# defaults to calling the API via a relative /api path when this isn't set,
# which is correct here since Nginx serves both under the same domain. Only
# set it (in frontend/.env.production, NOT read by the backend) if the
# frontend and backend ever end up on different domains.
