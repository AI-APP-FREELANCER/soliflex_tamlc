# Copy this file to ".env" on the droplet (same folder as docker-compose.yml) and fill in real values.
# Never commit the real ".env" — it's already in .gitignore.

# --- Domain / reverse proxy ---
DOMAIN=ta.soliflexpackaging.com
CORS_ORIGIN=https://ta.soliflexpackaging.com
VITE_API_BASE_URL=https://ta.soliflexpackaging.com

# --- Where persistent data lives on the droplet (the attached DO Volume's mount path) ---
DATA_DIR=/mnt/soliflex_data

# --- Postgres ---
POSTGRES_USER=soliflex
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=soliflex_ticketing
POSTGRES_PORT=5433

# --- Backend secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
