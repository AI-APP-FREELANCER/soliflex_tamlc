# Copy this file to ".env" on the droplet (same folder as docker-compose.prod.yml)
# and fill in real values. Never commit the real ".env" — it's already in .gitignore.

# --- Domain / reverse proxy ---
DOMAIN=ta.soliflexpackaging.com
CORS_ORIGIN=https://ta.soliflexpackaging.com
VITE_API_BASE_URL=https://ta.soliflexpackaging.com

# --- Where uploaded files (photos/invoices/QR codes) live on the droplet
# (the attached DO Volume's mount path) ---
DATA_DIR=/mnt/soliflex_data

# --- DigitalOcean Managed Database connection string ---
# Get this from: Databases -> soliflex-db -> Connection Details -> "Connection string"
# Prefer the "Private network" connection string (same region/VPC as the droplet) —
# it's faster and never touches the public internet. It already includes sslmode=require.
DATABASE_URL=postgresql://doadmin:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:25060/soliflex_ticketing?sslmode=require

# --- Backend secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
