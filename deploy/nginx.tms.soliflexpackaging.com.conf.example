# Example Nginx site config for tms.soliflexpackaging.com (plain, non-Docker deploy).
#
# Install:
#   sudo cp deploy/nginx.tms.soliflexpackaging.com.conf.example /etc/nginx/sites-available/tms.soliflexpackaging.com
#   sudo ln -s /etc/nginx/sites-available/tms.soliflexpackaging.com /etc/nginx/sites-enabled/
#   # edit the two REPLACE_WITH_... paths below to match where you deployed the code
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d tms.soliflexpackaging.com   # adds the HTTPS server block for you
#
# See DEPLOY.md for the full runbook.

server {
    listen 80;
    server_name tms.soliflexpackaging.com;

    # Built frontend static files (output of `npm run build` in frontend/)
    root REPLACE_WITH_ABSOLUTE_PATH/frontend/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # SPA fallback — React Router routes are client-side
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Backend API, file uploads, and websocket notifications — same origin,
    # so the frontend never has to deal with CORS.
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
