# --- Postgres ---
POSTGRES_USER=soliflex
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=soliflex_ticketing
POSTGRES_PORT=5433

# --- Backend ---
# Note: inside docker-compose the backend talks to the "postgres" service on its
# container port 5432 regardless of the host-exposed POSTGRES_PORT above.
DATABASE_URL=postgresql://soliflex:change_me_strong_password@postgres:5432/soliflex_ticketing?schema=tms
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000
