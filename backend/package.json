{
  "name": "soliflex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.22.2",
    "express-async-errors": "3.1.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "2.3.0",
    "node-cron": "3.0.3",
    "qrcode": "1.5.4",
    "socket.io": "4.8.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "1.5.5",
    "prisma": "5.20.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  },
  "allowScripts": {
    "@prisma/client@5.20.0": true,
    "prisma@5.20.0": true,
    "@prisma/engines@5.20.0": true,
    "esbuild@0.21.5": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
