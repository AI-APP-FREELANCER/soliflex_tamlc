# Copy to backend/.env for local development and fill in real values.
# The database is DigitalOcean managed Postgres — there is no local Postgres to run.
# From a machine outside DigitalOcean's own VPC (e.g. your laptop), use the
# database's PUBLIC connection hostname, not the "private-..." one (that's only
# reachable from inside DigitalOcean's network).
DATABASE_URL=postgresql://doadmin:REPLACE_WITH_PASSWORD@REPLACE_WITH_PUBLIC_HOST:25060/soliflex_ticketing?sslmode=require
JWT_ACCESS_SECRET=dev_access_secret_change_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
